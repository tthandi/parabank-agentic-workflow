__pycache__/
*.pyc
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.DS_Store

# Playwright artifacts that may contain session data — evidence we choose
# to commit is copied out explicitly, not dumped wholesale from here.
test-results/
playwright-report/
.playwright-mcp/

# Never commit real credentials or raw traces that might carry cookies/tokens.
*.har

# Machine-specific: which account/customer ids a local ParaBank instance
# actually got assigned. fixtures/personas.yaml (the intent) is committed;
# this (the outcome) is not.
fixtures/seeded.json

# The employer's assignment brief — reference material, not project source.
Assignment*.pdf
