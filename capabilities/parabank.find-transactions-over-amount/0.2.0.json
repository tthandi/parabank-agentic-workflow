{
  "id": "parabank.find-transactions-over-amount",
  "name": "Find checking-account transactions over an amount",
  "version": "0.2.0",
  "description": "Logs in, navigates to the customer's checking account, and returns every transaction on it with amount strictly greater than min_amount.",
  "target_app": "parabank",
  "entry_url": "http://localhost:8080/parabank/index.htm",
  "inputs": [
    {
      "name": "username",
      "type": "string",
      "required": true,
      "description": "Value for the 'Username' field.",
      "enum_values": null,
      "secret": false
    },
    {
      "name": "password",
      "type": "string",
      "required": true,
      "description": "ParaBank login password. Never persisted — supply at replay time.",
      "enum_values": null,
      "secret": true
    },
    {
      "name": "min_amount",
      "type": "float",
      "required": true,
      "description": "Whole-dollar threshold. Returns transactions with amount strictly greater than this value.",
      "enum_values": null,
      "secret": false
    }
  ],
  "outputs": [
    {
      "name": "matching_transactions",
      "type": "array",
      "description": "Transactions with amount > min_amount, as shown on the Account Activity page.",
      "source_locator": null,
      "item_shape": {
        "date": "string",
        "description": "string",
        "amount": "float",
        "direction": "string"
      }
    },
    {
      "name": "match_count",
      "type": "int",
      "description": "len(matching_transactions).",
      "source_locator": null,
      "item_shape": null
    }
  ],
