# Copy to .env and fill in. Never commit the real .env file.

# Anthropic API key used for the discovery-run agent loop (agent/llm.py).
ANTHROPIC_API_KEY=

# Target application under test. Points at the local Docker instance the
# README's Setup section runs (docker run ... parasoft/parabank -p 8080:8080).
# The public instance (https://parabank.parasoft.com/parabank) also works as
# a target, but scripts/seed_parabank.py refuses to seed it.
PARABANK_BASE_URL=http://localhost:8080/parabank

# Path to the safety allowlist config. Leave this UNSET unless you want a
# different allowlist than the repo's own: the default in cli.py is
# package-relative, so `cua` works from any directory. Setting it to the
# CWD-relative "config/allowlist.yaml" (as this file used to) silently
# reintroduces the bug that default exists to fix — `cua replay` then only
# works when invoked from the repo root.
# CUA_ALLOWLIST_PATH=/absolute/path/to/some-other-allowlist.yaml

# Run in headed mode so a human can see/take over the live session during
# escalation. Set to "true" for CI or unattended replay.
CUA_HEADLESS=false

# Login password for `cua run`/`cua replay`, kept out of --goal/--params on
# purpose (see REPORT.md #6) — prefer this env var over the --password flag
# so it never lands in shell history.
CUA_PASSWORD=
